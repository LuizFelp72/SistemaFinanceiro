# Copie para .env na raiz antes de executar `docker compose up`.
POSTGRES_DB=sistema_financeiro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Porta publicada pelo nginx (a API fica em http://localhost:<HTTP_PORT>/api/v1).
HTTP_PORT=80

# Obrigatório: segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d

# Opcional: origens permitidas no CORS separadas por vírgula (vazio permite qualquer origem em dev).
CORS_ORIGIN=

# Opcional: recuperação de senha por e-mail.
SMTP_URL=
MAIL_FROM=
APP_URL=http://localhost
